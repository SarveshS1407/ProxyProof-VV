# ==============================================================================
# PROXYPROOF PRODUCTION & STAGING ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit files containing real secrets or production credentials to Git.

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME METADATA
# ------------------------------------------------------------------------------
PROJECT_NAME="ProxyProof"
ENVIRONMENT="production"            # Options: 'development', 'staging', 'production'
DEBUG=false                         # MUST be 'false' in production

# ------------------------------------------------------------------------------
# 2. SECURITY & CRYPTOGRAPHIC AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY="replace-with-a-cryptographically-secure-random-secret-key-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440    # 24 hours (default session duration)

# ------------------------------------------------------------------------------
# 3. PRODUCTION DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# For Local Development:
# DATABASE_URL="sqlite:///./proxyproof.db"

# For Production (Neon, Supabase, AWS RDS, or PostgreSQL):
# Note: Always include sslmode=require for cloud-hosted databases.
DATABASE_URL="postgresql://proxyproof_user:proxyproof_secure_password@ep-pooler.us-east-1.aws.neon.tech/proxyproof_db?sslmode=require"

# ------------------------------------------------------------------------------
# 4. CORS & ALLOWED ORIGINS (Comma-Separated)
# ------------------------------------------------------------------------------
# Include your Vercel deployment URL, custom university domain, and mobile schemes:
CORS_ORIGINS="https://proxyproof.vercel.app,https://proxyproof-*-yourusername.vercel.app,http://localhost:5173,http://localhost:8081,exp://localhost:8081"

# ------------------------------------------------------------------------------
# 5. BLE ATTENDANCE PROTOCOL PARAMETERS
# ------------------------------------------------------------------------------
BLE_SERVICE_UUID="0000FD00-0000-1000-8000-00805F9B34FB"
BLE_TOKEN_ROTATION_SECONDS=10       # Rotating token interval in seconds
DEFAULT_MIN_RSSI=-85                # Maximum acceptable signal attenuation in dBm
RSSI_VARIANCE_TOLERANCE=15
CHALLENGE_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 6. RATE LIMITING (Sliding Window Security)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX_REQUESTS=10    # Max logins per minute per IP
RATE_LIMIT_REGISTER_MAX_REQUESTS=10 # Max registrations per minute per IP
RATE_LIMIT_SUBMIT_MAX_REQUESTS=30   # Max attendance check-ins per minute per IP
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION (Vite / Vercel Environment Variables)
# ------------------------------------------------------------------------------
# Set in Vercel Project Settings -> Environment Variables
# If deploying full-stack on the same domain (Vercel serverless), leave VITE_API_URL empty or '/api/v1'
# If pointing to a dedicated backend (Railway / Render):
# VITE_API_URL="https://api.proxyproof.edu"
# VITE_WS_URL="wss://api.proxyproof.edu"

# ------------------------------------------------------------------------------
# 8. MOBILE APPLICATION CLIENT (React Native / Expo)
# ------------------------------------------------------------------------------
# Set in mobile/.env:
# EXPO_PUBLIC_API_URL="https://proxyproof.vercel.app"
