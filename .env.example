# ProxyProof Environment Configuration
PROJECT_NAME="ProxyProof"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
SECRET_KEY="replace-this-with-a-secure-random-secret-key-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# For local development with SQLite:
DATABASE_URL="sqlite:///./proxyproof.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://proxyproof_user:proxyproof_pass@localhost:5432/proxyproof_db"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006,exp://localhost:8081"

# BLE & Attendance Protocol Parameters
BLE_SERVICE_UUID="0000FD00-0000-1000-8000-00805F9B34FB"
BLE_TOKEN_ROTATION_SECONDS=10
DEFAULT_MIN_RSSI=-85
RSSI_VARIANCE_TOLERANCE=15
CHALLENGE_TIMEOUT_SECONDS=60

# Rate Limiting
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_CHECKIN="20/minute"
