# ==============================================================================
# PROXYPROOF MOBILE ENVIRONMENT CONFIGURATION (mobile/.env.example)
# ==============================================================================

# Production Backend API URL
# Point this to your deployed Vercel domain or dedicated backend:
# EXPO_PUBLIC_API_URL=https://proxyproof.vercel.app

# Local Development (leave empty or uncomment for emulator/physical device):
# For Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# For Physical Device on Local Wi-Fi (replace with your machine's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
