{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "jsx": "react-native",
    "module": "esnext",
    "moduleResolution": "node",
    "typeRoots": ["../frontend/node_modules/@types"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["src/**/*", "App.tsx"]
}
