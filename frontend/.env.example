# ==============================================================================
# PROXYPROOF FRONTEND ENVIRONMENT CONFIGURATION (frontend/.env.example)
# ==============================================================================

# Option A: Unified Full-Stack Vercel Deployment (Same Origin)
# Leave empty or set to relative path so requests route through Vercel rewrites:
# VITE_API_URL=
# VITE_WS_URL=

# Option B: Decoupled Production Architecture (Dedicated Backend)
# Set to your production backend URL (Railway, Render, Fly.io, or VPS):
# VITE_API_URL=https://api.proxyproof.edu
# VITE_WS_URL=wss://api.proxyproof.edu

# Option C: Local Development with Uvicorn
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
